try x="760" y="120" width="520" height="26" as="geometry"/></mxCell><mxCell id="n1" value="INGESTION ARCHITECTURE BOUNDARY: The GCP Log Router only processes log records written to Cloud Logging. Services like SCC findings, Asset Inventory feeds, and GCS bucket object notifications publish directly to Pub/Sub via their own notification engines." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Barlow;fontColor=#8b93a7;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1380" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>